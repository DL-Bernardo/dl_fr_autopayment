<odoo>
    <record id="view_move_form_inherit_fr_payment" model="ir.ui.view">
        <field name="name">account.move.form.fr.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Campo técnico (invisível) para controlar condições -->
            <xpath expr="//sheet" position="inside">
                <field name="journal_code" invisible="1"/>
            </xpath>

            <!-- Adiciona campo Forma de Pagamento abaixo do campo Cliente -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="fr_payment_journal_id"
                       attrs="{'required': [('journal_code','=','FR')],
                               'invisible': [('journal_code','!=','FR')]}" />
            </xpath>
        </field>
    </record>
</odoo>