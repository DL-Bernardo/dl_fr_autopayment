<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_fr_payment" model="ir.ui.view">
        <field name="name">account.move.form.fr.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="journal_code" invisible="1"/>
                <field name="is_fr_journal" invisible="1"/>
                <field name="is_pos_invoice" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="fr_payment_journal_id"
                       options="{'no_create': True}"
                       required="move_type == 'out_invoice' and is_fr_journal and not is_pos_invoice"
                       invisible="move_type not in ('out_invoice', 'out_refund') or (move_type == 'out_invoice' and (not is_fr_journal or is_pos_invoice))"
                       readonly="state != 'draft'"/>
                <field name="fr_auto_payment_id"
                       invisible="not fr_auto_payment_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_move_out_invoice_fr" model="ir.actions.act_window">
        <field name="name">Faturas-Recibo (FR)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('is_fr_journal', '=', True)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Criar uma nova Fatura-Recibo (FR)
            </p>
            <p>
                As Faturas-Recibo (FR) geram e reconciliam automaticamente o pagamento no momento da confirmação.
            </p>
        </field>
    </record>

    <menuitem id="menu_action_move_out_invoice_fr"
              name="Faturas-Recibo (FR)"
              action="action_move_out_invoice_fr"
              parent="account.menu_finance_receivables"
              sequence="15"/>
</odoo>
