<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_inherit_fr_payment" model="ir.ui.view">
        <field name="name">account.journal.form.fr.payment</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="is_fr_journal" attrs="{'invisible': [('type', '!=', 'sale')]}"/>
                <field name="default_fr_payment_journal_id"
                       attrs="{'invisible': ['|', ('type', '!=', 'sale'), ('is_fr_journal', '=', False)]}"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
